{
  "name": "yeetkit-omarchy",
  "version": "0.1.0",
  "description": "Omarchy shell plugins written as yeetkit apps: SolidJS pages that run inside a yeet isolate and render into the Quattro bar and its panels over the tty portal.",
  "type": "module",
  "bin": {
    "yeetkit-omarchy": "./bin/yeetkit-omarchy.mjs"
  },
  "files": [
    "bin",
    "src",
    "qml",
    "templates",
    "UPSTREAM.md"
  ],
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "babel-preset-solid": "^1.9.0",
    "esbuild": "^0.28.0",
    "solid-js": "^1.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
